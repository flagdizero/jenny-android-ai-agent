<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- "Parla": il riconoscitore vocale dell'orologio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Sapere se c'è internet, per scegliere fra la voce di rete e quella
         dell'orologio (AskActivity.chooseVoice). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Solo per la voce propria (OwnVoice): chi imposta un suo sintetizzatore
         in rete lo chiama da qui. Senza quella impostazione l'app non apre
         nessuna connessione. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Timer e sveglie detti a voce partono dall'app Orologio dell'orologio,
         senza passare dal telefono: vedi LocalCommand. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Vedere i riconoscitori vocali, per controllare che chi ascolta davvero
         abbia il microfono (AskActivity.recognizerWithoutMic). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Vedere le app dell'elenco, per «apri …» detto a voce: senza, il
             loro nome non si legge e non si trova quella giusta. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_jenny_color"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Non autonoma: senza Jenny sul telefono l'app sul polso non ha
             nessuno a cui chiedere. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".AskActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Serve al ruolo di assistente: vedi Assistant.kt. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Jenny come assistente dell'orologio (pressione lunga del tasto).
             Sono tre servizi perché il sistema ne pretende tre: senza sessione
             e riconoscimento il servizio vocale non è considerato valido. -->
        <service
            android:name=".AssistService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".NoRecognitionService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Jenny sul quadrante. Due fonti, una per illustrazione: i quadranti
             di jenny-watchface le hanno come fornitore predefinito. -->
        <service
            android:name=".JennyComplicationService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/jenny_mono"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE,MONOCHROMATIC_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <service
            android:name=".PeekComplicationService"
            android:exported="true"
            android:label="@string/complication_peek"
            android:icon="@drawable/jenny_mono"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE,MONOCHROMATIC_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- Dopo un aggiornamento fa rinfrescare la complicazione (vedi la classe). -->
        <receiver
            android:name=".UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Solo per le prove via adb, e solo nelle build di debug (lo controlla
             il receiver): fa come se si fosse detta una frase. Protetto da
             DUMP, che ha la shell e nessuna app normale. -->
        <receiver
            android:name=".DebugAskReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.flagdizero.jenny.wear.DEBUG_ASK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
