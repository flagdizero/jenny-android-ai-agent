# Build & packaging
# Anchored to the repo root on purpose: unanchored `dist/` and `build/` also match
# jenny/templates/ui/assets/vendor/<pkg>/dist|build, which silently excluded the
# vendored KaTeX, Mermaid, highlight.js and Tabler icon-font assets that index.html
# loads and the APK bundles. Keep these anchored; add explicit paths for nested
# build outputs instead.
/dist/
/build/
android/**/build/
.gradle/
android/.gradle/
*.manifest
*.spec
pip-wheel-metadata/
share/python-wheels/

# Android local config, signing & build artifacts
local.properties
# Release signing credentials (see android/app/build.gradle.kts)
keystore.properties
*.keystore
*.jks
*.p12
android/captures/
.cxx/
.kotlin/
*.apk
*.aab

